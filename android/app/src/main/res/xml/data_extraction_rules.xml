<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep encrypted credentials out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sonora_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sonora_secure.xml" />
    </device-transfer>
</data-extraction-rules>
